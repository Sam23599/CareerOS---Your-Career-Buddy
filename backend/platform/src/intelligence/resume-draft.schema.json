    "id": {
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
      "title": "Id",
      "type": "string"
    },
    "version": {
      "maximum": 2147483647,
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "source": {
      "$ref": "#/$defs/Source"
    },
    "status": {
      "const": "ready",
      "default": "ready",
      "title": "Status",
      "type": "string"
    },
    "analyzerVersion": {
      "const": "resume-draft-v1",
      "default": "resume-draft-v1",
      "title": "Analyzerversion",
      "type": "string"
    },
    "provider": {
      "const": "openai",
      "default": "openai",
      "title": "Provider",
      "type": "string"
    },
    "model": {
      "enum": [
        "gpt-4.1",
        "gpt-6-luna",
        "gpt-6.1-sol"
      ],
      "title": "Model",
      "type": "string"
    },
    "reasoning": {
      "anyOf": [
        {
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Reasoning"
    },
    "usage": {
      "$ref": "#/$defs/Usage"
    },
    "createdAt": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Createdat",
      "type": "string"
    },
