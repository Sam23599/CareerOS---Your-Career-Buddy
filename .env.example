# Host ports for local development and Docker Compose.
WEB_PORT=5173
API_PORT=3000
MONGO_PORT=27017
# Used when running the API on your host. Match MONGO_PORT if you change it.
MONGODB_URI=mongodb://127.0.0.1:27017/careeros
# Compose supplies its own internal URI and proxy target.

# Generate this with npm run setup. Never commit or share the generated value.
AUTH_SECRET=
# Empty means localhost and 127.0.0.1 on WEB_PORT.
AUTH_ALLOWED_ORIGINS=
# Enable when using HTTPS. Required in production.
AUTH_COOKIE_SECURE=false

# Optional OAuth sign-in. Set a matching ID/secret pair to enable each provider.
# Defaults to the first allowed frontend origin. Register callbacks on this origin.
OAUTH_PUBLIC_ORIGIN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional host API file storage; Compose uses /data/resumes in a named volume.
# RESUME_STORAGE_DIR=./data/resumes

# Private PDF extraction. Setup generates a separate service token.
# Compose uses http://intelligence:8000 internally. This URL is for host Node.
INTELLIGENCE_SERVICE_URL=http://127.0.0.1:8000
INTELLIGENCE_SERVICE_TOKEN=
